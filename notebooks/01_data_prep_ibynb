import pandas as pd
import numpy as np

df = pd.read_csv('../data/raw/shopping_behavior_updated.csv')

print(df.shape)
print(df.head())
print(df.isnull().sum())

df.columns = df.columns.str.strip().str.lower().str.replace(' ', '_')

df = df.drop_duplicates()

df['review_rating'] = df['review_rating'].fillna(df['review_rating'].median())
df = df.dropna(subset=['age', 'purchase_amount_(usd)'])

df = df.rename(columns={'purchase_amount_(usd)': 'purchase_amount'})

for col in ['discount_applied', 'promo_code_used', 'subscription_status']:
    df[col] = df[col].map({'Yes': 1, 'No': 0})

df['age'] = df['age'].astype(int)
df['purchase_amount'] = df['purchase_amount'].astype(float)

df['age_group'] = pd.cut(df['age'],
    bins=[0,25,35,50,100],
    labels=['18-25','26-35','36-50','50+'])

df['loyalty_tier'] = pd.cut(df['previous_purchases'],
    bins=[0,10,25,100],
    labels=['Bronze','Silver','Gold'])

df['is_high_value'] = (df['purchase_amount'] >= df['purchase_amount'].quantile(0.75)).astype(int)

df.to_csv('../data/processed/shopping_cleaned.csv', index=False)

from sqlalchemy import create_engine

